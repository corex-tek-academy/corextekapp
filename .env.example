# Corex Tek-Academy — Environment Variables
# ==========================================
# Copy this file to .env and fill in the values.

# Supabase Configuration (required for enrollment form submissions)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Storage Bucket: "payments" (for enrollment payment receipts)
# Supabase Table: "cohort1_reg_tb" (stores enrollment registrations)
